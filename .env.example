# ─────────────────────────────────────────────
#  FIREBASE REALTIME DATABASE
#  (Get these from Firebase Console → Project Settings → Your Apps → SDK setup)
# ─────────────────────────────────────────────
REACT_APP_FIREBASE_API_KEY=paste-your-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=paste-your-sender-id
REACT_APP_FIREBASE_APP_ID=paste-your-app-id

# ─────────────────────────────────────────────
#  RESEND EMAIL API
#  (Get from resend.com → API Keys)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_paste_your_resend_api_key_here

# ─────────────────────────────────────────────
#  FROM EMAIL (optional — defaults to Resend test address)
#  Must be a verified sender domain on Resend for production use.
#  For testing, leave this out to use onboarding@resend.dev
# ─────────────────────────────────────────────
# FROM_EMAIL=Roots Recruitment <recruitment@yourdomain.com>
